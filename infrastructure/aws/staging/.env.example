# Copy nothing from this file to Git. The host script obtains real values from
# AWS Systems Manager Parameter Store and creates /opt/hotel-booking/runtime/.env.
POSTGRES_USER=hotel_booking
POSTGRES_PASSWORD=replace-with-a-secret
JWT_SECRET=replace-with-a-secret
GUEST_ACCESS_ENCRYPTION_SECRET=replace-with-a-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-secret
USE_SWAGGER=false
CORS_ALLOWED_ORIGINS=https://hotel.wiznick.net
NOTIFICATION_EMAIL_FROM=no-reply@staging.hotelbooking.local
