# Copy nothing from this file to Git. The host script obtains real values from
# AWS Systems Manager Parameter Store and creates /opt/hotel-booking/runtime/.env.
POSTGRES_USER=hotel_booking
POSTGRES_PASSWORD=replace-with-a-secret
JWT_PRIVATE_KEY_BASE64=replace-with-a-base64-encoded-pkcs8-rsa-private-key
JWT_PUBLIC_KEY_BASE64=replace-with-a-base64-encoded-x509-rsa-public-key
GUEST_ACCESS_ENCRYPTION_SECRET=replace-with-a-secret
IDENTITY_BOOTSTRAP_USERNAME=admin
IDENTITY_BOOTSTRAP_PASSWORD=replace-with-a-unique-initial-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-secret
USE_SWAGGER=false
CORS_ALLOWED_ORIGINS=https://hotel.wiznick.net
NOTIFICATION_EMAIL_FROM=no-reply@staging.hotelbooking.local
PUBLIC_FRONTEND_BASE_URL=https://hotel.wiznick.net
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_SMTP_TIMEOUT_MS=5000
MAIL_SMTP_WRITE_TIMEOUT_MS=5000
