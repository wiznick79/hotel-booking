# Copy this file to terraform.tfvars for local customisation. Never commit that copy.

aws_region   = "eu-west-3"
project_name = "hotel-booking"
environment  = "staging"

# For a private test environment, replace this with your public IP address plus /32.
public_ingress_cidrs = ["0.0.0.0/0"]

# This project runs a full Docker Compose stack, so 8 GiB is the safe initial size.
ec2_instance_type          = "t3.large"
ec2_root_volume_size_gib   = 30

# Keep false during normal operation. Set true only for a reviewed final teardown
# after copying the final PostgreSQL backup outside AWS.
force_destroy_deployment_bucket = false
