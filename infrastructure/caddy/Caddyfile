(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(gateway_api) {
	@management path /actuator/*
	handle @management {
		respond 404
	}

	@api path /api/*
	handle @api {
		reverse_proxy api-gateway:8080 {
			health_uri /actuator/health
			health_interval 10s
			health_timeout 3s
		}
	}
}

hotel.wiznick.net {
	encode zstd gzip
	import security_headers
	import gateway_api

	handle {
		reverse_proxy public-web:80
	}
}

admin.hotel.wiznick.net {
	encode zstd gzip
	import security_headers
	import gateway_api

	handle {
		reverse_proxy admin-web:80
	}
}
